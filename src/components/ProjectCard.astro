---
import ExternalIcon from "@/assets/icons/external.svg"
import { getProjectHref } from "@/data/project"
import { Image } from "astro:assets"
import type { CollectionEntry } from "astro:content"

type Props = { project: CollectionEntry<"project"> }

const { project } = Astro.props
const { title, description, links, stack, image, status } = project.data
const href = getProjectHref(project)
const external = links.website ?? links.repository
---

<li>
  {image && (
      <a
        href={href}
        tabindex="-1"
        aria-hidden="true"
      >
        <Image src={image.src} alt="" width={640} height={336} />
      </a>
    )}
  <entry-info>
    <a href={href}>{title}</a>
    <entry-meta>
      {status && <span>{status}</span>}
      {external && (
        <project-link>
          <ExternalIcon aria-hidden="true" />
          {new URL(external).hostname}
        </project-link>
      )}
    </entry-meta>
    <p>{description}</p>
    {stack.length > 0 && (
        <project-tags>
          {stack.map((tag) => (
            <span>{tag}</span>
          ))}
        </project-tags>
      )}
  </entry-info>
</li>

<style>
  li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-s);

    > a {
      flex-shrink: 0;
      inline-size: 14rem;

      :global(img) {
        inline-size: 100%;
        block-size: auto;
      }
    }

    entry-info {
      display: flex;
      flex-direction: column;

      > a {
        font-size: var(--step-1);
        line-height: calc(var(--leading-offset) + 1em);
        font-weight: var(--font-weight-medium);
      }

      entry-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-3xs);
        margin-block-end: var(--space-3xs);
        font-size: var(--step--1);
        color: var(--muted-foreground);

        project-link {
          display: flex;
          align-items: center;
          gap: var(--space-3xs);
          color: color-mix(in oklab, var(--muted-foreground) 50%, transparent);

          svg {
            inline-size: 1em;
            block-size: 1em;
          }
        }

        span ~ project-link::before {
          content: "·";
          color: var(--muted-foreground);
        }
      }

      p {
        color: var(--muted-foreground);
      }

      project-tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3xs);
        margin-block-start: var(--space-2xs);
        font-size: var(--step--1);

        span {
          padding-inline: var(--space-2xs);
          color: var(--muted-foreground);
          background-color: color-mix(in oklab, var(--muted) 50%, transparent);
          border-radius: var(--radius-full);
        }
      }
    }

    @media (width < 40rem) {
      flex-direction: column;

      > a {
        inline-size: 100%;
        max-inline-size: 32rem;
      }
    }
  }
</style>
