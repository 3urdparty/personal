---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"

const experience = [
  {
    role: "Robotics R&D Engineer",
    organization: "Hammock Robotics",
    location: "Malaysia",
    period: "May 2025 - Present",
    achievements: [
      "Develop ROS and ROS2 autonomy software for plantation drones, including obstacle avoidance, LiDAR odometry, SLAM, and real-time YOLO inference.",
      "Built a plantation-object training pipeline that balanced drone imagery datasets and improved model accuracy to 89.7%.",
      "Simulated a custom drone in Gazebo and ran SITL and HITL missions to tune control, navigation, and avoidance systems before field deployment.",
      "Integrated 3D LiDAR, cameras, PX4 flight controllers, and Jetson Orin Nano companion computers for GPS-limited operation.",
      "Developed image-based tree geotagging and A*/Theta* route planning, reducing the time required to map 10 trees by 16.4%.",
      "Designed and built a handheld geotagging demo device and a live diagnostics dashboard for point clouds, detections, and obstacle avoidance.",
    ],
  },
  {
    role: "Co-founder, IoT Solutions & Software Lead",
    organization: "Pogo Labs",
    location: "Cyberjaya, Malaysia",
    period: "Jul 2024 - Feb 2025",
    achievements: [
      "Co-founded a software and IoT agency focused on embedded integration and hardware-software interfaces, delivering a contract project for an SMB client.",
      "Led sensor-based systems spanning ESP-IDF firmware, cloud services, dashboards, and iOS-compatible Matter platform support.",
      "Delivered end-to-end products using ESP8266, MQTT, Laravel, Vue.js, and MySQL.",
      "Designed custom sensor housings and deployed hardware enclosures in Fusion 360.",
    ],
  },
]

const projects = [
  {
    title: "SLAM-enabled hexapod robot",
    meta: "Final-year research project - ongoing",
    description:
      "A campus-mapping hexapod built around a ToF depth camera, custom gait planning, and inverse kinematics for low-resource edge hardware.",
    details: [
      "Programmed the ESP32 with ESP-IDF, CMake, and FreeRTOS, including drivers for PCA9685 PWM control, LSM6DS3TR-C IMU, GPS, and custom interfaces.",
      "Designed, soldered, and validated the main control board and integrated sensing, actuation, power distribution, and peripheral interfaces.",
      "Designed and 3D-printed the frame after validating geometry, sensor placement, and locomotion constraints in Gazebo.",
    ],
  },
  {
    title: "PCB, motor control, and mechatronics",
    meta: "Independent engineering projects",
    description:
      "Custom electronics and mechanisms for legged robots, from power conversion and board bring-up to closed-loop motor control.",
    details: [
      "Designed and fabricated a 20 V-to-3.3 V BEC PCB in KiCad, including reflow assembly and board bring-up.",
      "Designed a legged-robot controller with an STM32 MCU and IMU sensing, plus a custom DRV8316 BLDC FOC driver board.",
      "Wrote FOC firmware with encoder feedback and PID control, and fabricated a cycloidal drive for low-backlash joint reduction.",
    ],
  },
  {
    title: "Custom drone odometry test platform",
    meta: "Robotics / PX4 / Jetson",
    description:
      "A custom drone for evaluating lightweight odometry with a low-cost ToF camera and onboard companion computer.",
    details: [
      "Configured PX4 and connected the flight controller to a Jetson Orin Nano.",
      "Integrated the camera, controller, companion computer, and autonomy software for onboard odometry experiments.",
    ],
  },
  {
    title: "AI-powered warehouse ERP",
    meta: "Inventoor Hackathon - award-winning submission",
    description:
      "A warehouse system combining computer vision, LLM processing, IoT telemetry, and robotics control.",
    details: [
      "Implemented YOLOv8 inventory detection with a Raspberry Pi camera pipeline.",
      "Built a Nest.js backend and MQTT layer to coordinate detections, reasoning, device events, and a warehouse robot concept.",
    ],
  },
  {
    title: "Clock-In",
    meta: "Pogo Labs client project",
    description:
      "A full-stack IoT employee attendance system built with Laravel, Vue.js, MySQL, MQTT, and ESP8266 devices.",
    details: [
      "Developed embedded sensor firmware with Arduino and MicroPython.",
      "Implemented real-time device-to-backend communication and centralized device management.",
    ],
  },
]

const skills = [
  {
    label: "Languages",
    value: "C/C++, Python, Bash, JavaScript/TypeScript, Java, Go, Swift",
  },
  {
    label: "Robotics",
    value:
      "ROS2, Gazebo, PX4, SLAM, visual and LiDAR odometry, navigation, obstacle avoidance",
  },
  {
    label: "Embedded",
    value:
      "ESP-IDF, FreeRTOS, ESP32, STM32, ST-LINK, Raspberry Pi, Jetson Orin Nano, Arduino, MicroPython",
  },
  {
    label: "Hardware",
    value:
      "KiCad, PCB design, IMU integration, PWM servo control, BLDC FOC, encoders, PID control",
  },
  {
    label: "CAD & fabrication",
    value:
      "Fusion 360, 3D printing, PrusaSlicer, robot frames, drone assemblies, cycloidal drives",
  },
  {
    label: "Computer vision & AI",
    value:
      "YOLO, OpenCV, point-cloud visualization, tree geotagging, image-based localization",
  },
  {
    label: "Web & IoT",
    value: "MQTT, REST APIs, Nest.js, Laravel, Vue.js, MySQL, Docker, Git",
  },
  { label: "Spoken languages", value: "English, Arabic, German" },
]
---

<Layout crumbs={[{ label: "Credentials", href: "/credentials" }]}>
  <MetaPage
    slot="head"
    title="Credentials"
    description="Mustafa Yousif's robotics, embedded systems, and software engineering experience."
  />

  <article class="credentials">
    <header class="intro">
      <p class="eyebrow">Credentials</p>
      <h1>Mustafa Yousif</h1>
      <p class="role">Robotics R&D engineer</p>
      <p class="summary">
        I build autonomous and embedded robotic systems across firmware,
        electronics, perception, control, and mechanical design. My work spans
        drones, SLAM-enabled legged robots, sensor fusion, PCB design, FOC motor
        control, CAD, and 3D-printed hardware.
      </p>
      <nav class="contact" aria-label="Contact links">
        <a href="mailto:mustafa.y.elagib@gmail.com">Email</a>
        <a href="tel:+601123049307">Phone</a>
        <a href="https://www.linkedin.com/in/mustafa-yousif-694080193/"
          >LinkedIn</a
        >
        <a href="https://github.com/3urdparty">GitHub</a>
      </nav>
    </header>

    <section aria-labelledby="experience-heading">
      <header class="section-heading">
        <p>01</p>
        <h2 id="experience-heading">Experience</h2>
      </header>
      <div class="entries">
        {experience.map((item) => (
          <article class="entry">
            <div class="entry-heading">
              <div>
                <h3>{item.role}</h3>
                <p>{item.organization} · {item.location}</p>
              </div>
              <time>{item.period}</time>
            </div>
            <ul>
              {item.achievements.map((achievement) => <li>{achievement}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section aria-labelledby="projects-heading">
      <header class="section-heading">
        <p>02</p>
        <h2 id="projects-heading">Selected engineering work</h2>
      </header>
      <div class="entries projects">
        {projects.map((project) => (
          <article class="entry project">
            <p class="project-meta">{project.meta}</p>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <ul>
              {project.details.map((detail) => <li>{detail}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section aria-labelledby="education-heading">
      <header class="section-heading">
        <p>03</p>
        <h2 id="education-heading">Education</h2>
      </header>
      <article class="entry education">
        <div class="entry-heading">
          <div>
            <h3>Bachelor of Science in Computer Science</h3>
            <p>Multimedia University · Cyberjaya, Malaysia</p>
          </div>
          <time>Mar 2023 - Mar 2026</time>
        </div>
        <p>GPA 3.72/4.00 · Multiple-time Dean's List Award recipient</p>
        <p>
          Focus: data science, AI applications, robotics, computer vision, and
          embedded systems.
        </p>
      </article>
    </section>

    <section aria-labelledby="skills-heading">
      <header class="section-heading">
        <p>04</p>
        <h2 id="skills-heading">Technical range</h2>
      </header>
      <dl class="skills">
        {skills.map((skill) => (
          <div>
            <dt>{skill.label}</dt>
            <dd>{skill.value}</dd>
          </div>
        ))}
      </dl>
    </section>
  </article>
</Layout>

<style>
  .credentials {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl-2xl);
  }

  .intro {
    padding-block-end: var(--space-l);
    border-block-end: 2px solid var(--border);
  }

  .eyebrow,
  .section-heading > p,
  .project-meta {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted-foreground);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    margin-block-start: var(--space-2xs);
    color: var(--foreground);
    font-size: var(--step-4);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .role {
    margin-block-start: var(--space-xs);
    color: var(--foreground);
    font-size: var(--step-1);
  }

  .summary {
    max-inline-size: 62ch;
    margin-block-start: var(--space-m);
    color: var(--muted-foreground);
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
    margin-block-start: var(--space-m);
  }

  .contact a {
    color: var(--foreground);
    text-underline-offset: 0.2em;
  }

  .section-heading {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: var(--space-xs);
    align-items: baseline;
    margin-block-end: var(--space-m);
  }

  .section-heading h2 {
    color: var(--foreground);
    font-size: var(--step-2);
    font-weight: var(--font-weight-medium);
    line-height: 1.1;
  }

  .entries {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }

  .entry {
    padding-block-start: var(--space-m);
    border-block-start: 1px solid var(--border);
  }

  .entry-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-s);
    align-items: start;
  }

  .entry h3 {
    color: var(--foreground);
    font-size: var(--step-1);
    font-weight: var(--font-weight-medium);
    line-height: 1.25;
  }

  .entry-heading p,
  .entry time,
  .project > p {
    color: var(--muted-foreground);
  }

  .entry time {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    white-space: nowrap;
  }

  .entry ul {
    margin-block-start: var(--space-s);
  }

  .entry li + li {
    margin-block-start: var(--space-2xs);
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-l) var(--space-m);
  }

  .project h3 {
    margin-block-start: var(--space-2xs);
  }

  .project > p:not(.project-meta),
  .education > p {
    margin-block-start: var(--space-xs);
  }

  .education > p + p {
    margin-block-start: var(--space-2xs);
  }

  .skills {
    border-block: 1px solid var(--border);
  }

  .skills div {
    display: grid;
    grid-template-columns: minmax(8rem, 0.65fr) minmax(0, 1.6fr);
    gap: var(--space-s);
    padding-block: var(--space-xs);
  }

  .skills div + div {
    border-block-start: 1px solid var(--border);
  }

  .skills dt {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted-foreground);
  }

  .skills dd {
    margin: 0;
    color: var(--foreground);
  }

  @media (width < 42rem) {
    .entry-heading,
    .skills div,
    .projects {
      grid-template-columns: 1fr;
    }

    .entry time {
      white-space: normal;
    }
  }
</style>
